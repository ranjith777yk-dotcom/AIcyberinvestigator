CYBERINVESTIGATOR_ENV=production
POSTGRES_PASSWORD=replace-with-secret-manager-value
SECRET_KEY=change-me-with-a-strong-random-value
DATABASE_URL=postgresql+psycopg://cyberinvestigator:${POSTGRES_PASSWORD}@db:5432/cyberinvestigator
TRUSTED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_SECURE=true
CSRF_ENABLED=true
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
OBSERVABILITY_MAX_TRACES=5000
BACKUP_ROOT=backups
APP_PORT=8000
RELEASE_VERSION=local
GIT_SHA=unknown
BUILD_TIME=unknown
DATABASE_AUTO_CREATE_SCHEMA=true
DEFAULT_USER=investigator
DEFAULT_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
USER_ROLES=investigator:admin
EVIDENCE_MAX_FILE_BYTES=1073741824
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
AI_API_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_ALLOWED_PROVIDER_HOSTS=localhost,127.0.0.1,::1
PLUGIN_CREDENTIAL_ENCRYPTION_KEY=
PLUGIN_ARCHIVE_MAX_FILES=256
PLUGIN_ARCHIVE_MAX_EXPANDED_BYTES=52428800
PLUGINS_ENABLED=true
SECRET_REFERENCES=
